{"nodes": [{"id": "docs_structure", "label": "Todo App: Project Structure", "file_type": "document", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_structure_two_ui_one_core", "label": "Two UIs, one core", "file_type": "concept", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "domain/, data/ and network/ never import a UI library, so desktop shadcn and mobile Framework7 pages share one feature core."}, {"id": "docs_structure_detect_ui_mode", "label": "detectUiMode() UI selection", "file_type": "concept", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI mode is decided once at startup (not on resize) so page state is never destroyed mid-session; screen width is deliberately unused so a narrow desktop window stays on the desktop UI."}, {"id": "docs_structure_route_branching", "label": "Per-route UI branching (desktop static / mobile dynamic import)", "file_type": "concept", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each route statically imports the desktop skeleton but dynamically imports the mobile page so framework7-svelte never enters the desktop bundle."}, {"id": "docs_structure_network_layer", "label": "src/network (mock or HTTP transport)", "file_type": "concept", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_structure_f7_ui_only", "label": "Framework7 is UI only \u2014 SvelteKit owns routing", "file_type": "concept", "source_file": "docs/structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "c